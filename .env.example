# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI & LLM Provider Settings (Optional: Deterministic fallback enabled if not set)
LLM_PROVIDER=template
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# Fleet Optimization Defaults
DEFAULT_MIN_SOC_BUFFER=15.0
DEFAULT_MAX_SOC_TARGET=90.0
DEFAULT_CHARGING_EFFICIENCY=0.92
OPTIMIZATION_SOLVER=heuristic
